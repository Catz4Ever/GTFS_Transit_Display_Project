# Database used by containers and local API tooling.
DB_HOST=db
DB_PORT=5432
DB_NAME=transit_db
DB_USER=transit_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_POOL_MAX_SIZE=25

# Fernet key used for encrypted stored credentials / GTFS-RT URLs.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=CHANGE_ME_FERNET_KEY

# External Mosquitto broker running on the host machine.
# Docker Desktop containers reach the host via host.docker.internal.
MQTT_ENABLED=true
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=transit
MQTT_USERNAME=CHANGE_ME_MQTT_USERNAME
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# Runtime manager
RUNTIME_MANAGER_SYNC_INTERVAL_SECONDS=15
STOP_ARRIVALS_ENABLED=true

# Worker cadence
SIM_INTERVAL_SECONDS=15
SIM_ACTIVE_TRIP_LOOKBEHIND_SECONDS=900
SIM_ACTIVE_TRIP_LOOKAHEAD_SECONDS=7200
FUSION_INTERVAL_SECONDS=15
STOP_ARRIVALS_INTERVAL_SECONDS=15
STOP_ARRIVALS_HORIZON_SECONDS=1800
STOP_ARRIVALS_LIMIT_PER_STOP=8
STOP_ARRIVALS_SHAPE_SPEED_MPS=7.0
STOP_ARRIVALS_SHAPE_MAX_DISTANCE_M=150
STOP_ARRIVALS_SHAPE_PASSED_GRACE_M=80

# SERVICE_TIMEZONE is no longer used. Timezone is read from city_runtime_config
# in the database for all services, ensuring consistency between the API and
# the MQTT stop-arrivals publisher.

# Fusion matching thresholds
# Strong identity matches can tolerate more physical drift than route fallback.
FUSION_MAX_MATCH_DISTANCE_TRIP_PK_M=1000
FUSION_MAX_MATCH_DISTANCE_TRIP_ID_M=500
FUSION_MAX_MATCH_DISTANCE_ROUTE_M=150
FUSION_RT_MAX_AGE_SECONDS=120

# Optional simulation overrides. Normally these are set per city from city_runtime_config.
# SIM_CITY_CODE=sofia
# SIM_FORCE_DATE=2022-03-15
# SIM_FORCE_TIME=14:30:00
SIM_SERVICE_DAY_ROLLOVER_HOUR=4

LOG_LEVEL=INFO

# GTFS import pruning
# Set to false temporarily for very large feeds while debugging imports.
GTFS_PRUNE_ENABLED=true
GTFS_PRUNE_BATCH_SIZE=1000

# Cleanup / partitioning service
PARTITIONING_ENABLED=true
PARTITION_MANAGER_ENABLED=true
PARTITION_DAYS_BACK=0
PARTITION_BACKGROUND_DAYS_BACK=0
PARTITION_DAYS_AHEAD=3
PARTITION_STARTUP_DAYS_BACK=0
PARTITION_STARTUP_DAYS_AHEAD=3
PARTITION_LOCK_TIMEOUT_MS=5000

CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=300
RT_STOP_TIME_RETENTION_HOURS=1
RT_TRIP_RETENTION_HOURS=1
RT_VEHICLE_RETENTION_HOURS=1
RT_ALERT_RETENTION_HOURS=3
POSITION_HISTORY_RETENTION_HOURS=3
RT_SNAPSHOT_RETENTION_HOURS=3
CLEANUP_VACUUM_ENABLED=false

# Admin panel authentication.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_TOKEN=CHANGE_ME_ADMIN_SECRET_TOKEN
